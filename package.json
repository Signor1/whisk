{
  "name": "whisk",
  "private": true,
  "version": "0.0.0",
  "description": "Whisk — embeddable USDC send widget built on Circle App Kit. Workspace root.",
  "license": "MIT",
  "author": "SignorDev (https://github.com/Signor1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --filter './packages/*' --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "typecheck:packages": "pnpm -r --filter './packages/*' typecheck",
    "typecheck:examples": "pnpm -r --filter './examples/*' typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  },
  "pnpm": {
    "overrides": {
      "axios@<1.15.2": ">=1.15.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,mdx,css,yaml,yml}": "prettier --write"
  }
}
